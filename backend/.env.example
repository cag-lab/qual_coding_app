# Optional fallback Azure OpenAI credentials.
# If omitted, credentials are provided from the step 1 UI.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional shared secret — frontend sends this in X-App-Secret header
APP_SHARED_SECRET=change-me-or-leave-blank-for-localhost-only

# Security hardening
# In production this defaults to true unless explicitly set to false.
# REQUIRE_SHARED_SECRET=true

# API rate limit (applies per IP to /api/*)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=120

# Server
PORT=3001

# Local dev frontend origin
# CORS_ORIGIN=http://localhost:5173
